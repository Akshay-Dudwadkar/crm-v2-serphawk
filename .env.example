# Database
DATABASE_URL=postgresql://db_user:db_password@db_host:5432/crm_database

# Application authentication
SECRET_KEY=replace_with_a_long_random_application_secret
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret

# Optional: safe admin seed; both values are required and the password must be 12+ characters
SEED_ADMIN_EMAIL=optional_admin_email
SEED_ADMIN_PASSWORD=optional_admin_password_12_chars_minimum

# Optional: AI features fail without these values
OPENAI_API_KEY=optional_openai_api_key
GEMINI_API_KEY=optional_gemini_api_key

# Optional: email notification and outreach features fail without these values
SENDER_EMAIL=optional_sender_email
SENDER_PASSWORD=optional_sender_password
EMAIL_SENDER=optional_email_sender
EMAIL_PASSWORD=optional_email_password
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=optional_smtp_username
SMTP_PASSWORD=optional_smtp_password
IMAP_SERVER=optional_imap_server
IMAP_PORT=993

# Frontend API base. Local development uses the backend directly;
# production uses the Nginx /api proxy path.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=/api